#!/bin/sh
# Mantiene la identidad de Astra OS aunque se actualicen filesystem o lsb-release.
set -e
install -m644 /usr/share/quantum/os-release /usr/lib/os-release
if [ -f /etc/lsb-release ]; then
    cat > /etc/lsb-release <<'LSB'
DISTRIB_ID="Astra"
DISTRIB_RELEASE="rolling"
DISTRIB_DESCRIPTION="Astra OS"
LSB
fi
